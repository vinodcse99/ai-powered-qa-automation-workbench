{
  "name": "enterprise-data-catalog-qa",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node scripts/server.mjs",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:chromium": "playwright test --project=chromium",
    "test:ai": "node src/run-approved-ai-test-run.mjs",
    "ai:approve": "node src/approve-ai-test-run.mjs",
    "ai:execute": "node src/run-approved-ai-test-run.mjs",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:all": "npm run typecheck && npm run test:unit && npm run test:chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "dotenv": "^18.0.10"
  }
}
